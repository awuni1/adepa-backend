DJANGO_SETTINGS_MODULE=adepa.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres — Session pooler connection string (port 5432, *.pooler.supabase.com host)
DATABASE_URL=postgres://user:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

REDIS_URL=redis://localhost:6379/0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

GROQ_API_KEY=

# Resend — transactional email (SMTP relay: smtp.resend.com, username "resend")
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Adepa HR <onboarding@resend.dev>

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173
